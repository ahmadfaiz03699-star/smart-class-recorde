{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.smartclassrecorder.bmqnaq",
      "infoPlist": {
        "NSCameraUsageDescription": "Snap a question to get AI step-by-step solution",
        "NSPhotoLibraryUsageDescription": "Pick a question image to ask the AI Tutor",
        "NSMicrophoneUsageDescription": "Ask AI Tutor questions with your voice"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#059669"
      },
      "package": "com.emergent.smartclassrecorder.bmqnaq",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#059669"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Snap a question to get AI step-by-step solution",
          "microphonePermission": "Ask AI Tutor questions with your voice"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick a question image to ask the AI Tutor"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
